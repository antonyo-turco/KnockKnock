@startuml PATH_B
skinparam ActivityBackgroundColor #1e1e2e
skinparam ActivityBorderColor #fab387
skinparam ActivityFontColor #cdd6f4
skinparam ActivityFontSize 13
skinparam ArrowColor #fab387
skinparam NoteBackgroundColor #313244
skinparam NoteBorderColor #6c7086
skinparam NoteFontColor #cdd6f4

title PATH B — Sensor Wakeup (EXT0 — knock detected)

start

if (!rtc_is_trained?) then (YES)
  :ESP_LOGW "No model";
  :esp_restart();
  note right: Falls back to PATH A\nto run training
  stop
endif

:gettimeofday(&tv_check);

if (tv_check.tv_sec < 1 000 000 000?) then (YES — clock never synced)
  :hub_comm_init();
  :hub_comm_get_information(5s, retry=3);
  note right: time_sin / time_cos would be\ninvalid without clock sync\nbefore ML inference
endif

:xSemaphoreCreateBinary();

fork
  partition "sensor_sampler_task\nCore 0 — Priority 5" {
    :Sample SAMPLE_COUNT readings\nat SAMPLING_RATE_HZ\nusing vTaskDelayUntil;
    :xSemaphoreGive(sem);
    :vTaskDelete(NULL);
  }
fork again
  partition "ml_processor_task\nCore 1 — Priority 4" {
    :xSemaphoreTake(sem, portMAX_DELAY);
    :get_time_features(&time_sin, &time_cos);
    :compute_features(g_xb, g_yb, g_zb,\nSAMPLE_COUNT, SAMPLING_RATE_HZ,\ntime_sin, time_cos);

    :training_load(&model);
    note right: Single full load\nof the model from NVS

    if (load OK?) then (NO)
      :ESP_LOGE;
      :goto_deep_sleep();
      stop
    endif

    :training_is_baseline(&model, &feat,\n&dist, &cluster);
    :gettimeofday(&tv_now);

    if (is_baseline?) then (YES — normal knock)

      :delta_sec = tv_now.tv_sec\n- rtc_last_sensor_wakeup_sec;

      if (delta_sec < THRESHOLD_ADJUST_TIME_SEC?) then (YES — too frequent)
        :rtc_threshold_mg += THRESHOLD_STEP_UP;
        :clamp(rtc_threshold_mg, THRESHOLD_MG_MAX);
        note right: Raise threshold:\nreduce false wakeups
      else (NO — normal timing)
        :rtc_threshold_mg -= THRESHOLD_STEP_DOWN;
        :clamp(rtc_threshold_mg, THRESHOLD_MG_MIN);
        note right: Lower threshold:\nstay sensitive
      endif

      :rtc_last_sensor_wakeup_sec = tv_now.tv_sec;

    else (NO — ANOMALY detected)

      :hub_comm_init();
      note right: Loads PMK/LMK/MAC only now\nthat hub communication is needed

      :hub_comm_send_alarm(code=1, retry=3);

      :hub_comm_get_information(5s, retry=3);
      note right: Resync clock after alarm

      if (got_info?) then (YES)
        if (do_reset?) then (YES)
          :handle_hub_reset();
          stop
        endif
        if (do_ml_training?) then (YES)
          :run_training_phase(exp_ms, trn_ms);
          note right: See flow_05_training.puml
        endif
      endif

    endif

    :goto_deep_sleep();
    note right: Applies rtc_threshold_mg\nto ADXL362 before sleep
    stop
  }
end fork

:vTaskSuspend(NULL);
note right: app_main suspended\nwhile tasks are running
stop
@enduml
